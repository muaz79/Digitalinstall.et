# GEMINI_API_KEY: Optional for Gemini AI assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="file:./data/digital_install.db"

# Authentication & Security
AUTH_SECRET="digital-install-super-secure-jwt-secret-key-2026"
SESSION_EXPIRES_IN="7d"

# Storage Configuration (Local / S3 / Cloudinary / Supabase)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Dispatcher Configuration (SMTP / Resend / Console)
EMAIL_PROVIDER="console"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DIGITAL INSTALL <support@digitalinstall-et.com>"

# Payment Provider Configuration (Telebirr / CBE Birr / Chapa placeholder config)
PAYMENT_GATEWAY_PROVIDER="telebirr_cbe_mock"
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""

